# Node 24+, no package installation required.
HOST=127.0.0.1
PORT=4321
PUBLIC_ORIGIN=http://127.0.0.1:4321
# Set a random value of at least 32 characters before using the private API.
ADMIN_TOKEN=
DATA_DIR=./var
# Optional outbound email provider (Resend-compatible endpoint).
EMAIL_API_KEY=
EMAIL_FROM=
NOTIFY_EMAIL=
EMAIL_API_URL=https://api.resend.com/emails
# Set true only after review of the actual public investor journey.
INVESTORS_ENABLED=false
PUBLIC_READY=false
CONFIG_FILE=./config.local.json
