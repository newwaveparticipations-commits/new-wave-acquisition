{
  "name": "new-wave-acquisition",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "vars": {"PUBLIC_ORIGIN": "https://newwaveacquisition.fr", "PUBLIC_READY": "false", "INVESTORS_ENABLED": "false"},
  "triggers": {"crons": ["*/5 * * * *"]},
  "d1_databases": [{"binding": "DB", "database_name": "new-wave-acquisition", "database_id": "REPLACE_WITH_CREATED_D1_ID", "migrations_dir": "cloudflare/migrations"}]
}
